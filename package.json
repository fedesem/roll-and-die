{
  "name": "roll-or-die",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "vitest run",
    "test:client": "vitest run --dir client/tests",
    "test:server": "vitest run --dir server/tests",
    "test:e2e": "playwright test",
    "storybook": "npm run storybook --workspace client",
    "build-storybook": "npm run build-storybook --workspace client",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "quality": "biome check . && npm run build && npm run typecheck && npm run test",
    "check": "biome check . && npm run typecheck && npm run build && npm run test",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^8.2.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "knip": "^6.26.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.0.8",
    "msw": "^2.12.14",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "^2.5.3",
    "@biomejs/cli-linux-x64-musl": "^2.5.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.91.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "lefthook",
    "msw"
  ]
}
